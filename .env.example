# 复制为运行目录下的 .env，权限设为 600。不要把填好的 .env 提交进仓库。

PORT=3001
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ooapi
DB_PASSWORD=
DB_NAME=ooapi
WEB_DIR=/opt/ooapi/web/dist

# 超管账号。首次启动创建；已存在管理员时不会覆盖。
ADMIN_USERNAME=odi
ADMIN_PASSWORD=

# 未设置时会在运行目录生成 .jwt-secret（0600）。不要提交，也不要在部署时覆盖。
# JWT_SECRET=

# 可选：Google 订阅登录。不配置则该登录方式不可用。
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# 实盘门闩。默认关闭。设为 1、true、yes 或 on 才允许 mode=live 进入下单路径。
# 这个开关不写进策略表，页面保存策略也不会把它打开。
# TRADING_TESTNET_GREEN=
