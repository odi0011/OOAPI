# OOAPI 后端环境变量（复制为 .env 后按需修改）
# 注意：.env 不要提交到仓库

PORT=3001

# MySQL 连接
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ooapi
DB_PASSWORD=change-this-password
DB_NAME=ooapi

# 超级管理员初始密码（首次启动创建 root 账号时使用，请务必修改）
ADMIN_PASSWORD=change-this-admin-password

# JWT 签名密钥（留空则自动生成并保存到 .jwt-secret 文件）
JWT_SECRET=

# 在线更新用的 GitHub 仓库（owner/repo）与分支
GITHUB_REPO=odi0011/OOAPI
GITHUB_BRANCH=main

# 单次上游请求超时（毫秒）
REQUEST_TIMEOUT_MS=600000
